# Generated by xcodegen — never commit; regenerate with `xcodegen generate`.
*.xcodeproj/

# Xcode / SwiftPM build artifacts
.build/
DerivedData/
build/
*.xcworkspace/xcuserdata/
**/xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# On-device LLM weights — multi-GB, fetched via scripts/fetch-model.sh (never commit).
Models/
*.gguf
*.litertlm

# llama.cpp Metal runtime — vendored binary framework + its checkout, built on
# demand via scripts/build-llama-xcframework.sh (never commit; device-only).
Vendor/
.llama-build/
