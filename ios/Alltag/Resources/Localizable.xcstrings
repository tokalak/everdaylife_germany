      "comment": "Post-study transition tool (P6-S6)."
    },
    "tool_post_study_jobseeker_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolventinnen und Absolventen können einen Aufenthalt von bis zu 18 Monaten erhalten, um eine Stelle zu finden, die zu ihrem Abschluss passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graduates can get a residence permit for up to 18 months to find a job that matches their qualification."
          }
        }
