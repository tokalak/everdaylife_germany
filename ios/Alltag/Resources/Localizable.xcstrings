    "tool_taxid_intro": {
      "comment": "Tax-ID organizer: intro.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutschland hat mehrere Steuer-Nummern. Hier erfährst du, welche du wann brauchst, wie du sie bekommst – und du kannst das Format deiner Steuer-ID prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Germany has several tax numbers. Learn which one you need and when, how to get them, and check the format of your Steuer-ID."
