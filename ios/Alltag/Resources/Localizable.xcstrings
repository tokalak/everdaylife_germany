    "guidedoc_dr_s1_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist Anerkennung?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is recognition?"
          }
        }
      }
    },
    "guidedoc_dr_s1_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anerkennung prüft eine zuständige Stelle, ob dein ausländischer Abschluss einem deutschen gleichwertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In recognition, a competent body checks whether your foreign qualification is equivalent to a German one."
          }
        }
      }
    },
    "guidedoc_dr_s1_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis hilft dir, in deinem Beruf zu arbeiten – und oft auch beim Visum für Fachkräfte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outcome helps you work in your profession — and often with the skilled-worker visa too."
          }
        }
      }
    },
    "guidedoc_dr_s2_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglementierte Berufe: Die Anerkennung ist Pflicht, um arbeiten zu dürfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulated professions: recognition is required before you may work."
          }
        }
      }
    },
    "guidedoc_dr_s2_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht reglementierte Berufe: Du darfst ohne Anerkennung arbeiten – sie kann aber bei der Jobsuche helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-regulated professions: you may work without recognition — but it can help your job search."
          }
        }
      }
    },
    "guidedoc_dr_s2_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Visum als Fachkraft ist oft eine Anerkennung oder ein vergleichbarer Nachweis nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a skilled-worker visa, recognition or a comparable proof is often required."
          }
        }
      }
    },
    "guidedoc_dr_s2_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann brauchst du sie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you need it?"
          }
        }
      }
    },
    "guidedoc_dr_s3_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ärztinnen, Pflegekräfte und andere Gesundheitsberufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doctors, nurses and other health professions."
          }
        }
      }
    },
    "guidedoc_dr_s3_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehrkräfte und Erzieher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teachers and educators."
          }
        }
      }
    },
    "guidedoc_dr_s3_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Juristische und technische Berufe mit gesetzlichem Titelschutz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal and technical professions with protected titles."
          }
        }
      }
    },
    "guidedoc_dr_s3_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglementierte Berufe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulated professions"
          }
        }
      }
    },
    "guidedoc_dr_s3_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglementiert sind vor allem Berufe mit Verantwortung für Gesundheit, Sicherheit oder Recht, zum Beispiel:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulated professions are mainly those carrying responsibility for health, safety or law, for example:"
          }
        }
      }
    },
    "guidedoc_dr_s4_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde die zuständige Stelle – am einfachsten über anerkennung-in-deutschland.de."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the competent body — easiest via anerkennung-in-deutschland.de."
          }
        }
      }
    },
    "guidedoc_dr_s4_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Antrag und reiche deine Unterlagen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit your application and documents."
          }
        }
      }
    },
    "guidedoc_dr_s4_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stelle bewertet die Gleichwertigkeit und teilt dir das Ergebnis mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body assesses equivalence and tells you the result."
          }
        }
      }
    },
    "guidedoc_dr_s4_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So läuft die Anerkennung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How recognition works"
          }
        }
      }
    },
    "guidedoc_dr_s5_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschlusszeugnisse und Diplome (oft als beglaubigte Übersetzung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diplomas and certificates (often as certified translations)."
          }
        }
      }
    },
    "guidedoc_dr_s5_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweise über Inhalte und Dauer der Ausbildung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of the content and duration of your training."
          }
        }
      }
    },
    "guidedoc_dr_s5_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweise über Berufserfahrung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence of work experience."
          }
        }
      }
    },
    "guidedoc_dr_s5_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitätsnachweis (Reisepass)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of identity (passport)."
          }
        }
      }
    },
    "guidedoc_dr_s5_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Unterlagen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which documents?"
          }
        }
      }
    },
    "guidedoc_dr_s6_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volle Gleichwertigkeit: Dein Abschluss wird voll anerkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full equivalence: your qualification is fully recognised."
          }
        }
      }
    },
    "guidedoc_dr_s6_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilweise Gleichwertigkeit: Du kannst Unterschiede durch Anpassungslehrgänge oder eine Prüfung ausgleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial equivalence: you can make up the differences with an adaptation course or an exam."
          }
        }
      }
    },
    "guidedoc_dr_s6_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outcome"
          }
        }
      }
    },
    "guidedoc_dr_s7_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verfahren kostet meist eine Gebühr und kann einige Monate dauern – fang früh an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process usually costs a fee and can take several months — start early."
          }
        }
      }
    },
    "guidedoc_dr_s7_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Fachkräfte gibt es die Anerkennungspartnerschaft: einreisen und die Anerkennung in Deutschland nachholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skilled workers can use a recognition partnership: enter Germany and complete recognition here."
          }
        }
      }
    },
    "guidedoc_dr_s7_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Übersetzungen nur von anerkannten Stellen anfertigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have translations done only by recognised providers."
          }
        }
      }
    },
    "guidedoc_dr_s7_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        }
      }
    },
    "guidedoc_dr_source_aid": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anerkennung in Deutschland"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition in Germany (official portal)"
          }
        }
      }
    },
    "guidedoc_dr_source_miig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany – Anerkennung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany — recognition of qualifications"
          }
        }
      }
    },
    "guidedoc_dr_summary": {
      "comment": "Guide P6-G5 diploma recognition: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob dein ausländischer Abschluss in Deutschland zählt, klärt die Anerkennung. Bei manchen Berufen ist sie Pflicht, bei anderen freiwillig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether your foreign qualification counts in Germany is settled by recognition (Anerkennung). For some professions it is mandatory, for others optional."
          }
        }
      }
    },
    "guidedoc_hi_s1_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versicherungspflicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance is mandatory"
          }
        }
      }
    },
    "guidedoc_hi_s1_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person in Deutschland muss krankenversichert sein – das gilt auch für Zugezogene ab dem ersten Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone in Germany must have health insurance — including new arrivals, from day one."
          }
        }
      }
    },
    "guidedoc_hi_s1_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Nachweis bekommst du oft weder einen Aufenthaltstitel noch eine Anstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without proof you often can't get a residence permit or sign an employment contract."
          }
        }
      }
    },
    "guidedoc_hi_s2_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GKV: Der Beitrag richtet sich nach dem Einkommen; Familienmitglieder sind oft kostenlos mitversichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GKV: contributions depend on income; family members are often co-insured for free."
          }
        }
      }
    },
    "guidedoc_hi_s2_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PKV: Der Beitrag richtet sich nach Alter und Gesundheit; jeder zahlt einzeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PKV: premiums depend on age and health; everyone pays individually."
          }
        }
      }
    },
    "guidedoc_hi_s2_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesetzlich oder privat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statutory or private?"
          }
        }
      }
    },
    "guidedoc_hi_s2_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zwei Systeme: die gesetzliche (GKV) und die private Krankenversicherung (PKV)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are two systems: statutory (GKV) and private (PKV) health insurance."
          }
        }
      }
    },
    "guidedoc_hi_s3_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Angestellten sind in der GKV pflichtversichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most employees are required to be in the GKV."
          }
        }
      }
    },
    "guidedoc_hi_s3_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst über einer Einkommensgrenze oder als Selbstständige/Beamte ist die PKV wählbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only above an income threshold, or as self-employed / civil servants, can you opt for PKV."
          }
        }
      }
    },
    "guidedoc_hi_s3_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wechsel zurück in die GKV ist später oft schwierig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching back to the GKV later is often difficult."
          }
        }
      }
    },
    "guidedoc_hi_s3_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer wählt was?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who chooses what?"
          }
        }
      }
    },
    "guidedoc_hi_s4_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arztbesuche, Krankenhaus, Medikamente und Vorsorge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doctor visits, hospital, medication and preventive care."
          }
        }
      }
    },
    "guidedoc_hi_s4_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Angestellten tragen Arbeitgeber und Arbeitnehmer den Beitrag je zur Hälfte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For employees, the contribution is split evenly between employer and employee."
          }
        }
      }
    },
    "guidedoc_hi_s4_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine Krankenkasse frei wählen – die Leistungen sind weitgehend gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can freely choose your insurer (Krankenkasse) — benefits are largely the same."
          }
        }
      }
    },
    "guidedoc_hi_s4_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die GKV bietet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the GKV covers"
          }
        }
      }
    },
    "guidedoc_hi_s5_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Krankenkasse (GKV) und stelle einen Aufnahmeantrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Krankenkasse (GKV) and apply to join."
          }
        }
      }
    },
    "guidedoc_hi_s5_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst eine Versicherungsnummer und eine Gesundheitskarte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive an insurance number and a health card."
          }
        }
      }
    },
    "guidedoc_hi_s5_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Arbeitgeber meldet dich an; als Selbstständiger meldest du dich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your employer registers you; if self-employed, you register yourself."
          }
        }
      }
    },
    "guidedoc_hi_s5_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So versicherst du dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to sign up"
          }
        }
      }
    },
    "guidedoc_hi_s6_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studierende haben günstige Studententarife in der GKV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Students get low-cost student rates in the GKV."
          }
        }
      }
    },
    "guidedoc_hi_s6_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erwerbstätige Familienmitglieder sind in der GKV oft beitragsfrei mitversichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-working family members are often co-insured in the GKV at no extra cost."
          }
        }
      }
    },
    "guidedoc_hi_s6_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer nur kurz zu Besuch ist, braucht eine Reisekranken- oder EHIC-Versicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short-term visitors need travel health insurance or an EHIC card."
          }
        }
      }
    },
    "guidedoc_hi_s6_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonderfälle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special cases"
          }
        }
      }
    },
    "guidedoc_hi_s7_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Zusatzbeitrag und Service der Krankenkassen, bevor du wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the supplementary contribution and service of insurers before you choose."
          }
        }
      }
    },
    "guidedoc_hi_s7_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre deine Versicherungsbescheinigung gut auf – du brauchst sie für Behörden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your insurance certificate safe — you need it for the authorities."
          }
        }
      }
    },
    "guidedoc_hi_s7_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        }
      }
    },
    "guidedoc_hi_source_gkv": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GKV-Spitzenverband"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "National Association of Statutory Health Insurance Funds"
          }
        }
      }
    },
    "guidedoc_hi_source_miig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany – Krankenversicherung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany — health insurance"
          }
        }
      }
    },
    "guidedoc_hi_summary": {
      "comment": "Guide P6-G4 health insurance: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Deutschland ist eine Krankenversicherung Pflicht. Hier erfährst du, wie das System funktioniert und wie du dich versicherst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health insurance is mandatory in Germany. Here's how the system works and how to get covered."
          }
        }
      }
    },
    "guidedoc_rb_s1_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewerbe oder Freiberuf?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trade or freelance profession?"
          }
        }
      }
    },
    "guidedoc_rb_s1_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstständige in Deutschland gehören entweder zu den Freiberuflern oder betreiben ein Gewerbe. Die Einordnung hängt von deiner Tätigkeit ab, nicht von deinem Wunsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-employed people in Germany are either freelance professionals (Freiberufler) or run a trade (Gewerbe). Which one you are depends on your activity, not your preference."
          }
        }
      }
    },
    "guidedoc_rb_s1_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Unterschied bestimmt, ob du ein Gewerbe anmelden musst, ob Gewerbesteuer anfällt und ob du Mitglied der IHK wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference decides whether you must register a trade, whether trade tax applies, and whether you join the Chamber of Commerce (IHK)."
          }
        }
      }
    },
    "guidedoc_rb_s2_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ärztinnen, Anwälte, Steuerberater und Ingenieure."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doctors, lawyers, tax advisors and engineers."
          }
        }
      }
    },
    "guidedoc_rb_s2_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Journalistinnen, Übersetzer, Künstler und Designer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Journalists, translators, artists and designers."
          }
        }
      }
    },
    "guidedoc_rb_s2_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmiererinnen und IT-Beratende (oft, aber nicht immer)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software developers and IT consultants (often, but not always)."
          }
        }
      }
    },
    "guidedoc_rb_s2_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehrende und Coaches mit fachlicher Qualifikation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teachers and coaches with professional qualifications."
          }
        }
      }
    },
    "guidedoc_rb_s2_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer ist Freiberufler?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who counts as a Freiberufler?"
          }
        }
      }
    },
    "guidedoc_rb_s2_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiberufler üben eine wissenschaftliche, künstlerische, schriftstellerische, lehrende oder bestimmte beratende Tätigkeit aus (sog. Katalogberufe, § 18 EStG). Beispiele:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freelancers carry out scientific, artistic, literary, teaching or certain advisory work (the \"catalogue professions\", §18 of the income-tax act). Examples:"
          }
        }
      }
    },
    "guidedoc_rb_s3_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handel, Onlineshops und Einzelhandel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retail, online shops and commerce."
          }
        }
      }
    },
    "guidedoc_rb_s3_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastronomie, Handwerk und Dienstleistungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastronomy, skilled trades and services."
          }
        }
      }
    },
    "guidedoc_rb_s3_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermittlung, Agenturen und die meisten Start-ups."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brokering, agencies and most start-ups."
          }
        }
      }
    },
    "guidedoc_rb_s3_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer braucht ein Gewerbe?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who needs a trade licence?"
          }
        }
      }
    },
    "guidedoc_rb_s3_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer Waren verkauft, handwerklich oder gewerblich tätig ist oder nicht unter die Freien Berufe fällt, betreibt ein Gewerbe. Typisch:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you sell goods, do skilled-trade or commercial work, or simply don’t fall under the free professions, you run a trade. Typical cases:"
          }
        }
      }
    },
    "guidedoc_rb_s4_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewerbeanmeldung beim örtlichen Gewerbeamt (oft online), Gebühr meist 20–60 €."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File a Gewerbeanmeldung at your local trade office (often online); the fee is usually €20–60."
          }
        }
      }
    },
    "guidedoc_rb_s4_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Finanzamt schickt dir danach automatisch den Fragebogen zur steuerlichen Erfassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax office then automatically sends you the tax-registration questionnaire."
          }
        }
      }
    },
    "guidedoc_rb_s4_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflichtmitgliedschaft in IHK oder Handwerkskammer entsteht automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Membership in the Chamber of Commerce (IHK) or Crafts Chamber follows automatically."
          }
        }
      }
    },
    "guidedoc_rb_s4_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab einem Gewinn über dem Freibetrag fällt Gewerbesteuer an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the tax-free allowance on profit, trade tax (Gewerbesteuer) applies."
          }
        }
      }
    },
    "guidedoc_rb_s4_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewerbe anmelden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registering a trade (Gewerbe)"
          }
        }
      }
    },
    "guidedoc_rb_s5_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Gewerbeanmeldung nötig – du meldest dich direkt beim Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trade registration needed — you register directly with the tax office."
          }
        }
      }
    },
    "guidedoc_rb_s5_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle den Fragebogen zur steuerlichen Erfassung über ELSTER aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in the tax-registration questionnaire via ELSTER (the online tax portal)."
          }
        }
      }
    },
    "guidedoc_rb_s5_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst eine Steuernummer und kannst Rechnungen stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive a tax number (Steuernummer) and can start invoicing."
          }
        }
      }
    },
    "guidedoc_rb_s5_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Freiberufler starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting as a freelancer"
          }
        }
      }
    },
    "guidedoc_rb_s6_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Kleinunternehmergrenze (rund 25.000 € Umsatz) kannst du auf die Umsatzsteuer verzichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the small-business threshold (around €25,000 turnover) you can opt out of charging VAT."
          }
        }
      }
    },
    "guidedoc_rb_s6_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst weist du Umsatzsteuer aus und meldest sie regelmäßig ans Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise you charge VAT and report it to the tax office regularly."
          }
        }
      }
    },
    "guidedoc_rb_s6_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kümmere dich selbst um Kranken- und Rentenversicherung – als Selbstständiger bist du nicht automatisch pflichtversichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange your own health and pension insurance — as a self-employed person you are not automatically covered."
          }
        }
      }
    },
    "guidedoc_rb_s6_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Berufe (z. B. Künstler) können über die Künstlersozialkasse versichert sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some professions (e.g. artists) can be insured via the artists’ social fund (Künstlersozialkasse)."
          }
        }
      }
    },
    "guidedoc_rb_s6_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuern & Versicherung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes & insurance"
          }
        }
      }
    },
    "guidedoc_rb_s7_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Zweifel entscheidet das Finanzamt, ob du Freiberufler bist – frag im Voraus nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When in doubt the tax office decides whether you are a Freiberufler — ask in advance."
          }
        }
      }
    },
    "guidedoc_rb_s7_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nicht-EU-Bürger muss dein Aufenthaltstitel die selbstständige Tätigkeit erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a non-EU citizen, your residence permit must allow self-employment."
          }
        }
      }
    },
    "guidedoc_rb_s7_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Geld für die Steuer zurück – die erste Steuernachzahlung kommt oft erst Monate später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set money aside for tax — your first tax bill often arrives only months later."
          }
        }
      }
    },
    "guidedoc_rb_s7_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        }
      }
    },
    "guidedoc_rb_source_existenzgruender": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BMWK – Existenzgründungsportal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Federal Ministry — business start-up portal"
          }
        }
      }
    },
    "guidedoc_rb_source_miig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany – Selbstständigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany — self-employment"
          }
        }
      }
    },
    "guidedoc_rb_summary": {
      "comment": "Guide P6-G2 register business: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstständig in Deutschland: Bist du Freiberufler oder betreibst du ein Gewerbe? Das entscheidet, wo du dich anmeldest und wie du besteuert wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going self-employed in Germany: are you a freelance professional or running a trade? That decides where you register and how you are taxed."
          }
        }
      }
    },
    "guidedoc_rp_s1_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist ein Aufenthaltstitel?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is a residence permit?"
          }
        }
      }
    },
    "guidedoc_rp_s1_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Aufenthaltstitel ist die offizielle Erlaubnis, sich in Deutschland aufzuhalten – und meist auch zu arbeiten oder zu studieren. Er wird von der Ausländerbehörde erteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A residence permit is the official permission to stay in Germany — and usually to work or study too. It is issued by the local immigration office (Ausländerbehörde)."
          }
        }
      }
    },
    "guidedoc_rp_s1_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Titel kommen heute als elektronischer Aufenthaltstitel (eAT) im Scheckkartenformat mit Chip."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most permits are now issued as an electronic residence permit (eAT): a chip card the size of a credit card."
          }
        }
      }
    },
    "guidedoc_rp_s2_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staatsangehörige der EU, des EWR und der Schweiz brauchen keinen – für sie gilt Freizügigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Citizens of the EU, EEA and Switzerland don't need one — they have freedom of movement."
          }
        }
      }
    },
    "guidedoc_rp_s2_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen (Drittstaatsangehörige) brauchen für einen längeren Aufenthalt einen Aufenthaltstitel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone else (non-EU nationals) needs a residence permit for a longer stay."
          }
        }
      }
    },
    "guidedoc_rp_s2_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Einreise ist oft zuerst ein nationales Visum (Kategorie D) nötig, das du später vor Ort in einen Aufenthaltstitel umwandelst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To enter, you often need a national visa (category D) first, which you later convert into a residence permit once you're here."
          }
        }
      }
    },
    "guidedoc_rp_s2_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer braucht einen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who needs one?"
          }
        }
      }
    },
    "guidedoc_rp_s3_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaue Karte EU – für akademische Fachkräfte mit Job und Mindestgehalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EU Blue Card — for academic professionals with a job offer and a minimum salary."
          }
        }
      }
    },
    "guidedoc_rp_s3_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufenthaltserlaubnis zur Beschäftigung – für qualifizierte Fachkräfte mit anerkanntem Abschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work permit (skilled worker) — for qualified professionals with a recognised qualification."
          }
        }
      }
    },
    "guidedoc_rp_s3_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chancenkarte – punktebasierte Suche nach Arbeit, auch ohne vorherigen Vertrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opportunity Card (Chancenkarte) — a points-based permit to look for work without a contract yet."
          }
        }
      }
    },
    "guidedoc_rp_s3_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studium – für die Einschreibung an einer Hochschule."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Study permit — for enrolment at a university."
          }
        }
      }
    },
    "guidedoc_rp_s3_b5": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiennachzug – für Ehepartner und Kinder von hier Lebenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family reunification — for spouses and children of people living here."
          }
        }
      }
    },
    "guidedoc_rp_s3_b6": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niederlassungserlaubnis – unbefristet, nach mehreren Jahren rechtmäßigem Aufenthalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settlement permit — permanent, after several years of lawful residence."
          }
        }
      }
    },
    "guidedoc_rp_s3_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige Arten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common types"
          }
        }
      }
    },
    "guidedoc_rp_s4_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem passenden Visum einreisen (falls erforderlich)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter with the right visa (if required)."
          }
        }
      }
    },
    "guidedoc_rp_s4_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohnsitz anmelden (Anmeldung) – das brauchst du für fast alles Weitere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your address (Anmeldung) — you need this for almost everything that follows."
          }
        }
      }
    },
    "guidedoc_rp_s4_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin bei der Ausländerbehörde buchen – oft Wochen im Voraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book an appointment at the Ausländerbehörde — often weeks in advance."
          }
        }
      }
    },
    "guidedoc_rp_s4_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterlagen vollständig zusammenstellen und den Antrag stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather all your documents and submit the application."
          }
        }
      }
    },
    "guidedoc_rp_s4_b5": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrische Daten abgeben und die Gebühr zahlen (meist rund 100 €)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide biometric data and pay the fee (usually around €100)."
          }
        }
      }
    },
    "guidedoc_rp_s4_b6": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Karte warten – die eAT kommt einige Wochen später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the card — the eAT arrives a few weeks later."
          }
        }
      }
    },
    "guidedoc_rp_s4_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So beantragst du ihn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to apply"
          }
        }
      }
    },
    "guidedoc_rp_s5_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger Reisepass."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid passport."
          }
        }
      }
    },
    "guidedoc_rp_s5_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrisches Passfoto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometric passport photo."
          }
        }
      }
    },
    "guidedoc_rp_s5_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldebescheinigung (Anmeldung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of registration (Anmeldung)."
          }
        }
      }
    },
    "guidedoc_rp_s5_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweis über Krankenversicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of health insurance."
          }
        }
      }
    },
    "guidedoc_rp_s5_b5": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweis über gesicherten Lebensunterhalt (Arbeitsvertrag, Sperrkonto o. Ä.)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of secured livelihood (employment contract, blocked account, etc.)."
          }
        }
      }
    },
    "guidedoc_rp_s5_b6": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nach Titel: Abschluss, Anerkennung, Heiratsurkunde oder Immatrikulation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depending on the permit: qualification, recognition, marriage certificate or enrolment."
          }
        }
      }
    },
    "guidedoc_rp_s5_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumente, die du meist brauchst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents you usually need"
          }
        }
      }
    },
    "guidedoc_rp_s6_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Erteilung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you get it"
          }
        }
      }
    },
    "guidedoc_rp_s6_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Aufenthaltstitel ist meist befristet. Stelle den Verlängerungsantrag rechtzeitig – idealerweise 6 bis 8 Wochen vor Ablauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your permit is usually time-limited. Apply to renew it in good time — ideally 6 to 8 weeks before it expires."
          }
        }
      }
    },
    "guidedoc_rp_s6_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Titel erlauben dir, später eine Niederlassungserlaubnis oder die Einbürgerung zu beantragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some permits let you later apply for a settlement permit or citizenship."
          }
        }
      }
    },
    "guidedoc_rp_s7_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buche den Behördentermin so früh wie möglich – Wartezeiten sind in Großstädten lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book your appointment as early as possible — waiting times are long in big cities."
          }
        }
      }
    },
    "guidedoc_rp_s7_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Titel nie ablaufen, ohne die Verlängerung beantragt zu haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never let your permit lapse without having applied for renewal."
          }
        }
      }
    },
    "guidedoc_rp_s7_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre alle Dokumente sicher auf – im Dokumententresor der App hast du sie griffbereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep all documents safe — the app's document vault keeps them at hand."
          }
        }
      }
    },
    "guidedoc_rp_s7_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        }
      }
    },
    "guidedoc_rp_source_bamf": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BAMF – Migration & Aufenthalt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BAMF — migration & residence"
          }
        }
      }
    },
    "guidedoc_rp_source_miig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany – Visum & Aufenthalt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany — visa & residence"
          }
        }
      }
    },
    "guidedoc_rp_summary": {
      "comment": "Guide P6-G1 residence permit: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer aus einem Nicht-EU-Land länger in Deutschland bleiben will, braucht einen Aufenthaltstitel. So funktioniert er – von der Art bis zum Antrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone from a non-EU country who wants to stay in Germany longer needs a residence permit. Here's how it works — from the type to the application."
          }
        }
      }
    },
    "guidedoc_tx_s1_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grundlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basics"
          }
        }
      }
    },
    "guidedoc_tx_s1_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer in Deutschland lebt und arbeitet, zahlt Einkommensteuer. Bei Angestellten zieht der Arbeitgeber sie automatisch als Lohnsteuer vom Gehalt ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you live and work in Germany, you pay income tax. For employees, the employer automatically deducts it from your pay as wage tax (Lohnsteuer)."
          }
        }
      }
    },
    "guidedoc_tx_s1_p2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zum Grundfreibetrag bleibt dein Einkommen steuerfrei; darüber steigt der Steuersatz progressiv mit dem Einkommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to the basic tax-free allowance (Grundfreibetrag) your income is untaxed; above it the rate rises progressively with income."
          }
        }
      }
    },
    "guidedoc_tx_s2_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuer-Identifikationsnummer (Steuer-ID) ist 11-stellig, lebenslang gültig und kommt nach der Anmeldung per Post."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax identification number (Steuer-ID) has 11 digits, is valid for life, and arrives by post after you register your address."
          }
        }
      }
    },
    "guidedoc_tx_s2_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuernummer vergibt das Finanzamt für eine bestimmte Tätigkeit – etwa für Selbstständige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax number (Steuernummer) is issued by the tax office for a specific activity — e.g. for the self-employed."
          }
        }
      }
    },
    "guidedoc_tx_s2_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Arbeitgeber interessiert vor allem deine Steuer-ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your employer mainly needs your Steuer-ID."
          }
        }
      }
    },
    "guidedoc_tx_s2_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer-ID und Steuernummer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax ID and tax number"
          }
        }
      }
    },
    "guidedoc_tx_s3_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzu kommen ggf. Solidaritätszuschlag und Kirchensteuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On top may come the solidarity surcharge and church tax."
          }
        }
      }
    },
    "guidedoc_tx_s3_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du tatsächlich zahlst, hängt von Einkommen, Familienstand und Abzügen ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you actually pay depends on income, family status and deductions."
          }
        }
      }
    },
    "guidedoc_tx_s3_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkommensteuer & Tarif"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income tax & brackets"
          }
        }
      }
    },
    "guidedoc_tx_s3_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einkommensteuertarif ist progressiv: Die ersten Euro über dem Grundfreibetrag werden niedrig besteuert, hohe Einkommen mit dem Spitzensteuersatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income tax is progressive: the first euros above the allowance are taxed lightly, high incomes at the top rate."
          }
        }
      }
    },
    "guidedoc_tx_s4_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse 1: Alleinstehende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Class 1: single."
          }
        }
      }
    },
    "guidedoc_tx_s4_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassen 3/5 oder 4/4: Verheiratete, je nach Einkommensverteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classes 3/5 or 4/4: married couples, depending on how income is split."
          }
        }
      }
    },
    "guidedoc_tx_s4_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse 6: für ein zweites Arbeitsverhältnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Class 6: for a second job."
          }
        }
      }
    },
    "guidedoc_tx_s4_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerklassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax classes (Steuerklassen)"
          }
        }
      }
    },
    "guidedoc_tx_s4_p1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angestellte werden einer von sechs Steuerklassen zugeordnet. Sie bestimmt, wie viel Lohnsteuer monatlich einbehalten wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Employees are placed in one of six tax classes. The class sets how much wage tax is withheld each month."
          }
        }
      }
    },
    "guidedoc_tx_s5_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohnsteuer (Vorauszahlung auf die Einkommensteuer)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wage tax (an advance on your income tax)."
          }
        }
      }
    },
    "guidedoc_tx_s5_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozialabgaben: Renten-, Kranken-, Pflege- und Arbeitslosenversicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social contributions: pension, health, long-term care and unemployment insurance."
          }
        }
      }
    },
    "guidedoc_tx_s5_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ggf. Solidaritätszuschlag und Kirchensteuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where applicable, solidarity surcharge and church tax."
          }
        }
      }
    },
    "guidedoc_tx_s5_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was übrig bleibt, ist dein Nettogehalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What remains is your net salary."
          }
        }
      }
    },
    "guidedoc_tx_s5_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was vom Gehalt abgeht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What comes off your salary"
          }
        }
      }
    },
    "guidedoc_tx_s6_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Angestellte müssen keine abgeben – können aber freiwillig, oft mit Rückerstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many employees aren't required to file one — but can voluntarily, often getting a refund."
          }
        }
      }
    },
    "guidedoc_tx_s6_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflicht ist sie z. B. bei Selbstständigkeit, mehreren Jobs oder bestimmten Steuerklassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is mandatory e.g. for the self-employed, multiple jobs or certain tax classes."
          }
        }
      }
    },
    "guidedoc_tx_s6_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingereicht wird sie online über ELSTER, meist bis zum 31. Juli des Folgejahres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You file it online via ELSTER, usually by 31 July of the following year."
          }
        }
      }
    },
    "guidedoc_tx_s6_b4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbungskosten, Pendeln und Versicherungen können die Steuer senken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work expenses, commuting and insurance can lower your tax."
          }
        }
      }
    },
    "guidedoc_tx_s6_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuererklärung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The annual tax return"
          }
        }
      }
    },
    "guidedoc_tx_s7_b1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe Lohnabrechnungen und Belege auf – du brauchst sie für die Erklärung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep payslips and receipts — you need them for your return."
          }
        }
      }
    },
    "guidedoc_tx_s7_b2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lohnsteuerhilfeverein oder Steuerberater hilft bei kniffligen Fällen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wage-tax help association or tax advisor helps with tricky cases."
          }
        }
      }
    },
    "guidedoc_tx_s7_b3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuersätze und Freibeträge ändern sich jährlich – prüfe aktuelle Zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates and allowances change yearly — check current figures."
          }
        }
      }
    },
    "guidedoc_tx_s7_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        }
      }
    },
    "guidedoc_tx_source_elster": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ELSTER – Online-Finanzamt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ELSTER — the online tax office"
          }
        }
      }
    },
    "guidedoc_tx_source_miig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany – Steuern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it in Germany — taxes"
          }
        }
      }
    },
    "guidedoc_tx_summary": {
      "comment": "Guide P6-G3 taxes: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuern in Deutschland wirken kompliziert, folgen aber klaren Regeln. Hier sind die Grundlagen – von der Steuer-ID bis zur Steuererklärung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes in Germany look complicated but follow clear rules. Here are the basics — from your tax ID to the annual return."
          }
        }
      }
    },
