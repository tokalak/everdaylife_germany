            "state": "translated",
            "value": "Nationality"
          }
        }
      }
    },
    "tool_visaneed_required_detail": {
      "comment": "Visa-need tool (P6-T1): visa-required rationale. %@ = country name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staatsangehörige von %@ brauchen für einen Kurzaufenthalt ein Schengen-Visum. Beantrage es vor der Reise bei der zuständigen deutschen Auslandsvertretung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nationals of %@ need a Schengen visa for a short stay. Apply for it before travelling at the responsible German mission abroad."
          }
        }
      }
    },
    "tool_visaneed_required_title": {
      "comment": "Visa-need tool (P6-T1): visa-required result title.",
