    "tool_taxid_id_steuerid_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer-ID (Steuerliche Identifikationsnummer)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer-ID (tax identification number)"
          }
        }
      }
    },
    "tool_taxid_id_steuerid_what": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 11-stellige Nummer, die dich ein Leben lang begleitet. Jede in Deutschland gemeldete Person bekommt genau eine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An 11-digit number that stays with you for life. Everyone registered in Germany gets exactly one."
          }
        }
      }
    },
    "tool_taxid_id_steuerid_when": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für deinen Arbeitgeber, Bank, Kindergeld und die Steuererklärung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your employer, your bank, child benefit and your tax return."
          }
        }
      }
    },
    "tool_taxid_id_steuerid_where": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt nach der Anmeldung automatisch per Post. Du musst sie nicht beantragen. Du findest sie auch auf der Lohnsteuerbescheinigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives automatically by post after your Anmeldung. You do not have to apply for it. It also appears on your annual payslip statement."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuernummer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuernummer"
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_what": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nummer, die das Finanzamt für eine bestimmte Tätigkeit vergibt (z. B. Selbstständigkeit). Das Format hängt vom Bundesland ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number the tax office (Finanzamt) issues for a specific activity (e.g. self-employment). The format depends on the federal state."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_when": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Rechnungen als Selbstständige:r und die Kommunikation mit dem Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For invoices when self-employed and for communicating with the tax office."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_where": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über ELSTER oder beim zuständigen Finanzamt beantragen, meist nach der Anmeldung eines Gewerbes oder einer freiberuflichen Tätigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request it via ELSTER or your local Finanzamt, usually after registering a business or freelance activity."
          }
        }
      }
    },
    "tool_taxid_id_ustidnr_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
