    "tool_freelance_fb_confirm_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob dein Beruf zu den Katalogberufen oder ähnlichen freien Berufen gehört. Im Zweifel entscheidet das Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether your profession is a catalogue (liberal) profession or a similar free profession. If in doubt, the Finanzamt decides."
          }
        }
      }
    },
    "tool_freelance_fb_confirm_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiberufler-Status bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you qualify as a Freiberufler"
          }
        }
      }
    },
    "tool_freelance_fb_fragebogen_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiche den „Fragebogen zur steuerlichen Erfassung“ online über ELSTER beim Finanzamt ein. Ein Gewerbeamt brauchst du nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit the “Fragebogen zur steuerlichen Erfassung” to the Finanzamt online via ELSTER. You don’t need the Gewerbeamt."
          }
        }
      }
    },
    "tool_freelance_fb_fragebogen_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragebogen zur steuerlichen Erfassung ausfüllen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the tax-registration questionnaire"
          }
        }
      }
    },
    "tool_freelance_fb_insurance_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Selbstständiger organisierst du deine Krankenversicherung selbst. Manche freien Berufe haben eine Pflicht zur Renten- oder Künstlersozialkasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a self-employed person you arrange your own health insurance. Some free professions must pay into a pension fund or the Künstlersozialkasse."
          }
        }
      }
    },
    "tool_freelance_fb_insurance_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kranken- und Rentenversicherung regeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange health & pension insurance"
          }
        }
      }
    },
    "tool_freelance_fb_invoicing_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe ordnungsgemäße Rechnungen mit allen Pflichtangaben und bewahre Belege für die Steuererklärung auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write proper invoices with all required details and keep your receipts for the tax return."
          }
        }
      }
    },
    "tool_freelance_fb_invoicing_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Rechnungstellen beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start invoicing"
          }
        }
      }
    },
    "tool_freelance_fb_steuernummer_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Finanzamt schickt dir deine Steuernummer für die selbstständige Tätigkeit. Sie gehört auf jede Rechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finanzamt sends you the Steuernummer for your activity. It goes on every invoice you write."
          }
        }
      }
    },
    "tool_freelance_fb_steuernummer_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuernummer erhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive your Steuernummer"
          }
        }
      }
    },
    "tool_freelance_fb_vat_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide, ob du die Kleinunternehmerregelung nutzt (keine Umsatzsteuer) oder Umsatzsteuer ausweist. Das gibst du im Fragebogen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide whether to use the Kleinunternehmer scheme (no VAT) or charge VAT. You state this in the questionnaire."
          }
        }
      }
    },
    "tool_freelance_fb_vat_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinunternehmer oder Umsatzsteuer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinunternehmer vs charging VAT"
          }
        }
      }
    },
    "tool_freelance_gw_anmeldung_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dein Gewerbe beim örtlichen Gewerbeamt an. Das ist der erste Schritt für gewerbliche Tätigkeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your trade at the local Gewerbeamt. This is the first step for a commercial activity."
          }
        }
      }
    },
    "tool_freelance_gw_anmeldung_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewerbeanmeldung beim Gewerbeamt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File the Gewerbeanmeldung at the Gewerbeamt"
          }
        }
      }
    },
    "tool_freelance_gw_chamber_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Gewerbeanmeldung wirst du automatisch Pflichtmitglied der IHK oder Handwerkskammer (oft mit Jahresbeitrag)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the Gewerbeanmeldung you automatically become a mandatory member of the IHK or Handwerkskammer (usually with an annual fee)."
          }
        }
      }
    },
    "tool_freelance_gw_chamber_title": {
