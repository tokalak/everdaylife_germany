          "stringUnit": {
            "state": "translated",
            "value": "Arrange insurance"
          }
        }
      }
    },
    "tool_freelance_gw_steuernummer_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Fragebogen schickt dir das Finanzamt deine Steuernummer für das Gewerbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the questionnaire, the Finanzamt sends you the Steuernummer for your business."
          }
        }
