    "tool_working_hours_at_limit": {
      "comment": "Working-hours tracker: warning shown when the annual allowance is used up.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Jahreskontingent erreicht. Mehr Arbeit kann gegen deine Aufenthaltserlaubnis verstoßen — kläre das mit der Ausländerbehörde."
          }
        },
        "en": {
          "stringUnit": {
