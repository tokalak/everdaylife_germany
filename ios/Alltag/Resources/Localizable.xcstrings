        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Gewerbeanmeldung wirst du automatisch Pflichtmitglied der IHK oder Handwerkskammer (oft mit Jahresbeitrag)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the Gewerbeanmeldung you automatically become a mandatory member of the IHK or Handwerkskammer (usually with an annual fee)."
          }
        }
      }
    },
    "tool_freelance_gw_chamber_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitgliedschaft in IHK/Handwerkskammer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IHK/Handwerkskammer membership"
          }
        }
      }
    },
    "tool_freelance_gw_fragebogen_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Finanzamt schickt dir den Fragebogen zur steuerlichen Erfassung – oder du reichst ihn direkt über ELSTER ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finanzamt sends you the tax-registration questionnaire — or you file it directly via ELSTER."
          }
        }
