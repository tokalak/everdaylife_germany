    "tool_a1_test_why_body": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ehegattennachzug verlangen die Behörden meist einen Nachweis einfacher Deutschkenntnisse (A1)."
          }
