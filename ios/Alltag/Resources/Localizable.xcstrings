    },
    "tool_health_pkv_tradeoffs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitrag nach Gesundheit und Leistungsumfang, oft mehr Leistungen, aber jede Person zahlt eigene Beiträge und ein Rückwechsel in die GKV ist meist schwierig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiums based on health and chosen cover, often more benefits, but each person pays their own premium and returning to GKV is usually difficult."
          }
        }
      }
    },
    "tool_health_q_status": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bist du versichert oder beschäftigt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are you insured or employed?"
          }
        }
      }
    },
    "tool_health_result_depends_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Versicherung gilt, hängt von deiner genauen Situation ab (z. B. Rente, Arbeitssuche, Familienversicherung). Informiere dich bei einer Krankenkasse über deine Möglichkeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which cover applies depends on your exact situation (e.g. pension, job-seeking, family co-insurance). Ask a health fund about your options."
          }
        }
      }
    },
    "tool_health_result_depends_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt auf den Einzelfall an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depends on your case"
          }
        }
      }
    },
    "tool_health_result_gkv_or_pkv_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner Situation kannst du zwischen gesetzlicher (GKV) und privater (PKV) Krankenversicherung wählen. Vergleiche die Vor- und Nachteile sorgfältig – ein späterer Wechsel zurück in die GKV ist oft schwierig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your situation you can choose between statutory (GKV) and private (PKV) health insurance. Weigh the trade-offs carefully — switching back to GKV later is often difficult."
          }
        }
      }
    },
    "tool_health_result_gkv_or_pkv_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GKV oder PKV – du hast die Wahl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GKV or PKV — you can choose"
          }
        }
      }
    },
    "tool_health_result_must_gkv_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Angestellte:r mit einem Einkommen bis zur Versicherungspflichtgrenze bist du gesetzlich pflichtversichert. Du wählst eine gesetzliche Krankenkasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As an employee earning up to the compulsory-insurance threshold, you are insured in the statutory system. You choose a statutory health fund."
          }
        }
      }
    },
    "tool_health_result_must_gkv_title": {
