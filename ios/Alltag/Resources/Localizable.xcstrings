      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparenz: Einige Links sind Partnerlinks – wir erhalten dafür unter Umständen eine Provision. Das beeinflusst weder die Reihenfolge noch deinen Preis."
