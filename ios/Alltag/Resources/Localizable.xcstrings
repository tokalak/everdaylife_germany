    "tool_schengen_intro": {
      "comment": "Schengen counter: intro explaining the 90/180 rule.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Kurzaufenthalts-Besucher dürfen Sie sich innerhalb eines beliebigen Zeitraums von 180 Tagen höchstens 90 Tage im Schengen-Raum aufhalten. Tragen Sie Ihre vergangenen und geplanten Aufenthalte ein, um zu sehen, wie viele Tage Sie bereits genutzt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a short-stay visitor you may spend at most 90 days in the Schengen area within any 180-day period. Enter your past and planned stays to see how many days you have already used."
          }
        }
      }
    },
    "tool_schengen_official_note": {
      "comment": "Schengen counter: note that this is an estimate.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist nur eine Schätzung. Die verbindliche Berechnung finden Sie im offiziellen Schengen-Rechner der EU."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is only an estimate. The binding calculation is the official Schengen calculator on the EU website."
          }
        }
      }
    },
    "tool_schengen_remaining_fmt": {
      "comment": "Schengen counter: days remaining. %lld is the day count.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld Tage übrig"
