    "tool_anmeldung_what_body": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist die Registrierung deiner Wohnanschrift beim örtlichen Bürgeramt bzw. Einwohnermeldeamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Anmeldung is registering your home address at the local Bürgeramt (citizens' office) or Einwohnermeldeamt."
          }
        }
      }
    },
    "tool_anmeldung_what_heading": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
        "de": {
