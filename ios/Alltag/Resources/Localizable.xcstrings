    "settings_legal_body": {
      "comment": "About screen disclaimer body (RDG).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltag hilft dir, amtliche Briefe und Abläufe zu verstehen und zu organisieren. Es ersetzt keine Rechts- oder Steuerberatung. Bei rechtlichen Fragen wende dich an eine Anwältin oder einen Anwalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltag helps you understand and organize official letters and processes. It is not a substitute for legal or tax advice. For legal questions, consult a lawyer."
          }
        }
      }
    },
    "settings_legal_explanation": {
      "comment": "Settings row explanation.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltag bietet Informationen und Übersetzung — keine Rechts- oder Steuerberatung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltag provides information and translation — not legal or tax advice."
          }
        }
      }
    },
    "settings_legal_privacy": {
      "comment": "About screen privacy note.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem Gerät: Dokumente werden verschlüsselt gespeichert und die KI verarbeitet deine Briefe lokal. Nichts wird hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your device: documents are stored encrypted and the AI processes your letters locally. Nothing is uploaded."
          }
        }
      }
    },
