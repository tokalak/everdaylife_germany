          "stringUnit": {
            "state": "translated",
            "value": "Eine EU-weite Umsatzsteuer-Nummer für Unternehmen, die mit anderen EU-Ländern Geschäfte machen. Nur für Selbstständige und Firmen relevant."
          }
        },
        "en": {
