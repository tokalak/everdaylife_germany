    "tool_a1_test_why_visa": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du legst das Zertifikat zusammen mit dem Visumantrag bei der deutschen Auslandsvertretung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You submit the certificate together with your visa application at the German mission abroad."
