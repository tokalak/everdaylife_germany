    "tool_freelance_gw_insurance_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisiere deine Krankenversicherung selbst und prüfe sinnvolle betriebliche Versicherungen wie eine Betriebshaftpflicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange your own health insurance and consider sensible business cover such as professional liability insurance."
          }
        }
