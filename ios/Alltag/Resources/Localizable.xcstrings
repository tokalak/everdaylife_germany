          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa required"
          }
        }
      }
    },
    "tool_visaneed_verify_note": {
      "comment": "Visa-need tool (P6-T1): verify-with-Foreign-Office note for visa-required.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste kann unvollständig sein. Prüfe deinen Fall immer beim Auswärtigen Amt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list may be incomplete. Always check your case with the Auswärtiges Amt (German Foreign Office)."
          }
        }
      }
    },
    "tool_visaneed_visafree_detail": {
      "comment": "Visa-need tool (P6-T1): visa-free rationale. %@ = country name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staatsangehörige von %@ dürfen ohne Visum für einen Kurzaufenthalt einreisen. Für längere Aufenthalte oder zum Arbeiten ist ein Aufenthaltstitel nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nationals of %@ may enter without a visa for a short stay. A residence permit is required for longer stays or to work."
          }
        }
      }
    },
