          "stringUnit": {
            "state": "translated",
            "value": "Aktuell (%1$d) müssen rund %2$@ auf dem Sperrkonto liegen – das entspricht etwa %3$@ pro Monat. Bitte beim Auswärtigen Amt prüfen, der Betrag ändert sich jährlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
