    "guidedoc_rp_summary": {
      "comment": "Guide P6-G1 residence permit: summary line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer aus einem Nicht-EU-Land länger in Deutschland bleiben will, braucht einen Aufenthaltstitel. So funktioniert er – von der Art bis zum Antrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone from a non-EU country who wants to stay in Germany longer needs a residence permit. Here's how it works — from the type to the application."
