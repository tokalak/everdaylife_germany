            "state": "translated",
            "value": "What is A1?"
          }
        }
      }
    },
    "tool_a1_test_where_body": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung legst du bei einem lizenzierten Prüfungszentrum im Ausland ab – etwa beim Goethe-Institut oder bei Partnern von telc bzw. ÖSD."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the exam at a licensed test centre abroad — for example a Goethe-Institut or a telc or ÖSD partner."
          }
        }
      }
    },
