    "tool_studenthealth_intro": {
      "comment": "Student health-insurance comparison (P6-S3).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Krankenversicherung ist für die Immatrikulation Pflicht. Eingeschriebene Studierende unter ~30 nutzen meist die gesetzliche Studierendenversicherung (GKV-Studententarif) zu einem festen, niedrigen Monatsbeitrag, der für die Immatrikulation anerkannt wird. Wer den GKV-Studententarif nicht nutzen kann (über 30, Sprach- oder Vorbereitungskurs, manche Austauschgäste), wählt eine private/Incoming-Versicherung. Hier ein transparenter Vergleich beider Wege."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health insurance is mandatory to enrol. Enrolled students under ~30 usually take public student health insurance (GKV student tariff) at a fixed, low monthly rate that is accepted for enrolment. Those who can't use the GKV student tariff (over 30, language or preparatory course, some exchange visitors) take private/incoming insurance instead. Here is a transparent comparison of both routes."
          }
        }
      }
    },
    "tool_studenthealth_learn_more": {
      "comment": "Student health-insurance comparison (P6-S3).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr zur Krankenversicherung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn more about health insurance"
          }
        }
      }
    },
    "tool_studenthealth_open_action": {
