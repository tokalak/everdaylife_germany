    "tool_anmeldung_what_why": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst die Meldebescheinigung für fast alles: um eine Steuer-ID zu bekommen, viele Bankkonten zu eröffnen, Verträge abzuschließen und einen Aufenthaltstitel zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need the Meldebescheinigung for almost everything: to get a tax-ID, open many bank accounts, sign contracts and obtain a residence permit."
          }
        }
      }
    },
    "tool_anmeldung_where_body": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung erfolgt persönlich beim örtlichen Bürgeramt. Buche einen Termin – oft sind Termine erst Wochen im Voraus frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You register in person at the local Bürgeramt. Book an appointment — slots are often only available weeks ahead."
          }
        }
      }
    },
    "tool_anmeldung_where_heading": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
