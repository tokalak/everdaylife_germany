    "tool_freelance_gw_taxes_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide über die Kleinunternehmerregelung vs. Umsatzsteuer. Über dem Freibetrag fällt zusätzlich Gewerbesteuer an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide on Kleinunternehmer vs charging VAT. Above the allowance you also pay Gewerbesteuer (trade tax)."
