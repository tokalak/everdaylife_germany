    "tool_survival_etiquette_punctuality": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pünktlichkeit zählt – zu Terminen lieber etwas früher kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctuality matters — arrive a little early for appointments."
          }
        }
      }
    },
    "tool_survival_etiquette_tipping": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinkgeld: aufrunden bzw. etwa 5–10 %, direkt beim Bezahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipping: round up or about 5–10%, given directly when you pay."
          }
        }
      }
    },
    "tool_survival_intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wichtigste fürs Ankommen in Deutschland – ein freundlicher Überblick plus eine Checkliste für vor dem Abflug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The essentials for arriving in Germany — a friendly overview plus a before-you-fly checklist."
          }
        }
      }
    },
    "tool_survival_kit_subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wichtigste für deine erste Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The essentials for your first week."
          }
        }
      }
    },
    "tool_survival_kit_title": {
      "comment": "Tourist tool: survival kit.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Survival-Kit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Survival kit"
          }
        }
      }
    },
    "tool_survival_money_cards": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Geschäfte nehmen Girocard/EC, aber nicht überall Kreditkarten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many places take Girocard/EC, but not everywhere accepts credit cards."
          }
        }
      }
    },
    "tool_survival_money_cash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutschland ist bargeldfreundlich – führe immer etwas Euro bei dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Germany is cash-friendly — always carry some euros."
          }
        }
      }
    },
    "tool_survival_money_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money"
          }
        }
      }
    },
    "tool_survival_money_pfand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf viele Flaschen und Dosen gibt es Pfand – am Automaten im Supermarkt zurückgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many bottles and cans carry a deposit (Pfand) — return them at the supermarket machine for a refund."
          }
        }
      }
    },
    "tool_survival_transport_db": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Bahnfahrten ist die App DB Navigator der Deutschen Bahn hilfreich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For train journeys, Deutsche Bahn's DB Navigator app is handy."
          }
        }
      }
    },
    "tool_survival_transport_deutschlandticket": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Deutschland-Ticket gilt im Monatsabo für den regionalen Nah- und Regionalverkehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Deutschland-Ticket is a monthly pass valid on regional and local public transport."
          }
        }
      }
    },
    "tool_survival_transport_heading": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting around"
          }
        }
      }
    },
    "tool_survival_transport_validate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tickets vor oder beim Einstieg kaufen und entwerten – Fahren ohne gültiges Ticket wird teuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy and validate tickets before or as you board — travelling without a valid ticket gets expensive."
          }
        }
      }
    },
    "tool_taxid_checklist_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt für Schritt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step by step"
          }
        }
      }
    },
    "tool_taxid_id_steuerid_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer-ID (Steuerliche Identifikationsnummer)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer-ID (tax identification number)"
          }
        }
      }
    },
    "tool_taxid_id_steuerid_what": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 11-stellige Nummer, die dich ein Leben lang begleitet. Jede in Deutschland gemeldete Person bekommt genau eine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An 11-digit number that stays with you for life. Everyone registered in Germany gets exactly one."
          }
        }
      }
    },
    "tool_taxid_id_steuerid_when": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für deinen Arbeitgeber, Bank, Kindergeld und die Steuererklärung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your employer, your bank, child benefit and your tax return."
          }
        }
      }
    },
    "tool_taxid_id_steuerid_where": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt nach der Anmeldung automatisch per Post. Du musst sie nicht beantragen. Du findest sie auch auf der Lohnsteuerbescheinigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives automatically by post after your Anmeldung. You do not have to apply for it. It also appears on your annual payslip statement."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuernummer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuernummer"
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_what": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nummer, die das Finanzamt für eine bestimmte Tätigkeit vergibt (z. B. Selbstständigkeit). Das Format hängt vom Bundesland ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number the tax office (Finanzamt) issues for a specific activity (e.g. self-employment). The format depends on the federal state."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_when": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Rechnungen als Selbstständige:r und die Kommunikation mit dem Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For invoices when self-employed and for communicating with the tax office."
          }
        }
      }
    },
    "tool_taxid_id_steuernummer_where": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über ELSTER oder beim zuständigen Finanzamt beantragen, meist nach der Anmeldung eines Gewerbes oder einer freiberuflichen Tätigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request it via ELSTER or your local Finanzamt, usually after registering a business or freelance activity."
          }
        }
      }
    },
    "tool_taxid_id_ustidnr_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "USt-IdNr (Umsatzsteuer-Identifikationsnummer)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USt-IdNr (VAT ID)"
          }
        }
      }
    },
    "tool_taxid_id_ustidnr_what": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine EU-weite Umsatzsteuer-Nummer für Unternehmen, die mit anderen EU-Ländern Geschäfte machen. Nur für Selbstständige und Firmen relevant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An EU-wide VAT number for businesses trading with other EU countries. Only relevant for the self-employed and companies."
          }
        }
      }
    },
    "tool_taxid_id_ustidnr_when": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für innergemeinschaftliche Lieferungen und Leistungen innerhalb der EU."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For intra-EU supplies of goods and services."
          }
        }
      }
    },
    "tool_taxid_id_ustidnr_where": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos beim Bundeszentralamt für Steuern (BZSt) oder zusammen mit der steuerlichen Erfassung über ELSTER beantragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply for free at the Federal Central Tax Office (BZSt) or together with your tax registration via ELSTER."
          }
        }
      }
    },
    "tool_taxid_identifiers_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nummern im Überblick"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers at a glance"
          }
        }
      }
    },
    "tool_taxid_intro": {
      "comment": "Tax-ID organizer: intro.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutschland hat mehrere Steuer-Nummern. Hier erfährst du, welche du wann brauchst, wie du sie bekommst – und du kannst das Format deiner Steuer-ID prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Germany has several tax numbers. Learn which one you need and when, how to get them, and check the format of your Steuer-ID."
          }
        }
      }
    },
    "tool_taxid_learn_more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr über Steuern erfahren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn more about taxes"
          }
        }
      }
    },
    "tool_taxid_privacy_note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung erfolgt nur auf deinem Gerät. Deine Nummer wird nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check runs only on your device. Your number is not stored."
          }
        }
      }
    },
    "tool_taxid_step_anmeldung_subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb von 14 Tagen nach dem Einzug beim Bürgeramt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within 14 days of moving in, at the Bürgeramt."
          }
        }
      }
    },
    "tool_taxid_step_anmeldung_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohnsitz anmelden"
