    "tool_a1_test_format_parts": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung hat vier Teile: Hören, Lesen, Schreiben und Sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exam has four parts: listening (Hören), reading (Lesen), writing (Schreiben) and speaking (Sprechen)."
          }
        }
      }
    },
    "tool_a1_test_format_pass": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertet wird das Gesamtergebnis – du musst die Prüfung insgesamt bestehen."
