    "tool_working_hours_intro": {
      "comment": "Working-hours tracker: intro explaining the 140-full / 280-half day rule.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als internationale*r Student*in (Nicht-EU) darfst du pro Jahr begrenzt arbeiten: in der Regel 140 ganze oder 280 halbe Tage. Ein Tag bis 4 Stunden zählt als halber Tag, mehr als 4 Stunden als ganzer Tag. Trage deine Arbeitstage ein und sieh, wie viel deines Jahreskontingents übrig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a non-EU international student you may work a limited amount per year: usually 140 full days or 280 half days. A day of up to 4 hours counts as a half day, more than 4 hours as a full day. Log your work days and see how much of your annual allowance is left."
          }
        }
      }
    },
    "tool_working_hours_learn_more": {
      "comment": "Working-hours tracker: link into the residence-permit guide.",
