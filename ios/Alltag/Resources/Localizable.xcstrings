    "tool_a1_test_intro": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Familiennachzug zum Ehepartner ist meist ein Nachweis über einfache Deutschkenntnisse (Niveau A1) nötig. Diese Prüfung legst du in der Regel im Ausland ab, bevor du das Visum beantragst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouse reunification usually requires proof of basic German (level A1). You normally take this test abroad before you apply for the visa."
          }
        }
      }
    },
    "tool_a1_test_learn_more": {
      "comment": "A1 German test booking guide (P6-F2).",
