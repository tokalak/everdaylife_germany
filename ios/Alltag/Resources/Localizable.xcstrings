    "tool_anmeldung_deadline_body": {
      "comment": "Anmeldung guide (shared by Student and Worker).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in der Regel innerhalb von 14 Tagen nach dem Einzug an. Die genaue Frist kann je nach Stadt abweichen – prüfe sie vor Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register within 14 days of moving in, as a rule. The exact deadline can vary by city, so check it locally."
          }
        }
      }
    },
