    "tool_travel_schengen_note": {
      "comment": "Travel insurance comparison (P6-T4): Schengen €30,000 requirement note.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schengen-Visum: mindestens 30.000 € Deckung, gültig im gesamten Schengen-Raum und für die komplette Reisedauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schengen visa: at least €30,000 cover, valid across the whole Schengen area and for your entire trip."
          }
