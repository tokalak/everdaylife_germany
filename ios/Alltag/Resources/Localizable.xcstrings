    "tool_blocked_intro": {
      "comment": "Blocked account (Sperrkonto) comparison (P6-S2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Studierendenvisum musst du in der Regel nachweisen, dass du deinen Lebensunterhalt finanzieren kannst – meist über ein Sperrkonto. Du zahlst den Jahresbetrag ein und kannst monatlich einen festen Betrag abheben. Hier ein transparenter Vergleich gängiger Anbieter."
          }
        },
        "en": {
