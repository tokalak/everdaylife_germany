    "tool_a1_test_what_body": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A1 ist die unterste Stufe des Gemeinsamen Europäischen Referenzrahmens (GER): einfache Deutschkenntnisse für den Alltag – sich vorstellen, einfache Fragen stellen und beantworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A1 is the lowest level of the Common European Framework (CEFR): basic everyday German — introducing yourself and asking and answering simple questions."
          }
        }
      }
    },
    "tool_a1_test_what_exams": {
      "comment": "A1 German test booking guide (P6-F2).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übliche Prüfungen sind das Goethe-Zertifikat A1 „Start Deutsch 1“, telc Deutsch A1 und ÖSD Zertifikat A1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common exams are the Goethe-Zertifikat A1 “Start Deutsch 1”, telc Deutsch A1 and the ÖSD Zertifikat A1."
          }
        }
      }
    },
    "tool_a1_test_what_heading": {
      "comment": "A1 German test booking guide (P6-F2).",
