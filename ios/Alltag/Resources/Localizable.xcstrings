          "stringUnit": {
            "state": "translated",
            "value": "Statutory cover (GKV)"
          }
        }
      }
    },
    "tool_health_result_student_gkv_detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eingeschriebene Studierende gilt in der Regel der günstige studentische Tarif der gesetzlichen Krankenkassen. Internationale Studierende sollten prüfen, ob ihre Versicherung in Deutschland anerkannt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrolled students normally qualify for the affordable student tariff in the statutory system. International students should check whether their cover is recognised in Germany."
          }
        }
      }
    },
