    "tool_reunification_intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiennachzug erlaubt es engen Familienangehörigen, zu einer Person zu ziehen, die in Deutschland lebt. Wähle aus, wer nachziehen möchte, und du erhältst eine Liste der Unterlagen für den nationalen Visumantrag (Typ D)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family reunification lets close relatives join someone living in Germany. Choose who is joining and get a list of the documents for the national (type-D) visa application."
          }
        }
      }
    },
