    "tool_bank_intro": {
      "comment": "Bank comparison (P6-W4): intro.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Miete, Gehalt und Lastschriften brauchst du ein deutsches Girokonto mit IBAN. Hier findest du gängige Banken im Vergleich – sachlich und in einer sinnvollen Standard-Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For rent, salary and direct debits you need a German current account (Girokonto) with an IBAN. Here are common banks compared — factually and in a sensible default order."
          }
        }
      }
    },
