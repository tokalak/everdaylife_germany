    "tool_post_study_intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Studium in Deutschland abgeschlossen? So wechselst du von der studentischen Aufenthaltserlaubnis auf einen Weg zur Arbeit oder Arbeitssuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished your degree in Germany? Here is how to move from the student residence permit onto a working or job-seeking route."
          }
        }
      },
      "comment": "Post-study transition tool (P6-S6)."
    },
    "tool_post_study_jobseeker_before_expiry": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantrage ihn bei der Ausländerbehörde, bevor deine studentische Aufenthaltserlaubnis abläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply for it at the Ausländerbehörde before your student permit expires."
          }
        }
