    "tool_schengen_at_limit": {
      "comment": "Schengen counter: warning shown when no days remain.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben Ihr 90-Tage-Limit erreicht. Eine weitere Einreise könnte einen Überzug bedeuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached your 90-day limit. Entering again may mean overstaying."
          }
        }
      }
    },
